# Настройки сервиса (src/purchase_intent/config.py). Скопируйте в .env и раскомментируйте нужные строки.

# Подключение к Postgres для логов запросов. Без нее сервис работает, но не логирует.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/purchase_intent

# Путь к бандлу модели и папка с данными; по умолчанию - artifacts/model.joblib и data/ в корне репозитория.
# MODEL_PATH=artifacts/model.joblib
# DATA_DIR=data

# LOG_LEVEL=INFO
